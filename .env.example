# API Configuration
# Backend API endpoint for fetching hiring data
VITE_API_BASE_URL=http://localhost:3000/api

# Feature Flags - Enable/disable sections of the dashboard
VITE_FEATURE_HISTORICAL_DATA=true
VITE_FEATURE_EXPORT_PDF=true
VITE_FEATURE_CSV_IMPORT=true
VITE_FEATURE_ANALYTICS=true

# Build Configuration
VITE_APP_TITLE=Hiring Dashboard
VITE_APP_VERSION=1.0.0

# Analytics (optional)
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=

# Environment
NODE_ENV=production
